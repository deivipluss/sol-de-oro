{
    "version": 2,
    "builds": [
      {
        "src": "next.config.js",
        "use": "@vercel/next"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/"
      }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "out",
    "framework": "nextjs",
    "regions": ["iad1"],
    "images": {
      "sizes": [640, 750, 828, 1080, 1200],
      "minimumCacheTTL": 60
    }
  }